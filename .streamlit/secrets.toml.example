# Streamlit Secrets Template for Local Development
# 
# INSTRUCTIONS:
# 1. Copy this file and rename to: secrets.toml
# 2. Add your actual API key (the file will be ignored by git)
# 3. For Streamlit Cloud, add secrets via Settings → Secrets dashboard
#
# DO NOT COMMIT secrets.toml - it's in .gitignore

# OpenAI API Key (get from https://platform.openai.com/account/api-keys)
openai_api_key = "sk-your-api-key-here"

# Optional: Specify a different model (default: gpt-4o-mini)
# openai_model = "gpt-4-turbo"
